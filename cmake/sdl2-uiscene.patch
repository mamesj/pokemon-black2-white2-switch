diff -ru SDL2-2.32.10/src/video/uikit/SDL_uikitappdelegate.m ../b/SDL2-2.32.10/src/video/uikit/SDL_uikitappdelegate.m
--- a/src/video/uikit/SDL_uikitappdelegate.m	2025-01-01 10:47:53
+++ b/src/video/uikit/SDL_uikitappdelegate.m	2026-10-29 22:12:55
@@ -45,6 +45,13 @@
 #undef main
 #endif
 
+/* The app's window scene (UIApplicationSceneManifest in Info.plist): an app that takes part in
+ * the scene life cycle fills the whole display it is on, the folded-out one of a foldable
+ * iPhone too, instead of a compatibility box; the SDL window is attached to it
+ * (SDL_uikitwindow.m). (UIKit still posts the application notifications SDL_uikitevents.m
+ * follows, so only opened URLs need handing on.) */
+UIWindowScene *SDL_uikit_window_scene API_AVAILABLE(ios(13.0)) = nil;
+
 static SDL_main_func forward_main;
 static int forward_argc;
 static char **forward_argv;
@@ -346,6 +353,35 @@
     return UIInterfaceOrientationMaskAll;
 }
 #endif /* !TARGET_OS_TV */
+
+@end
+
+API_AVAILABLE(ios(13.0))
+@interface SDLUIKitSceneDelegate : UIResponder <UIWindowSceneDelegate>
+@end
+
+@implementation SDLUIKitSceneDelegate
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+    if ([scene isKindOfClass:[UIWindowScene class]]) {
+        SDL_uikit_window_scene = (UIWindowScene *)scene;
+    }
+}
+
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    if (scene == SDL_uikit_window_scene) {
+        SDL_uikit_window_scene = nil;
+    }
+}
+
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)URLContexts
+{
+    for (UIOpenURLContext *context in URLContexts) {
+        [(id)[UIApplication sharedApplication].delegate application:[UIApplication sharedApplication] openURL:context.URL options:@{}];
+    }
+}
 
 @end
 
